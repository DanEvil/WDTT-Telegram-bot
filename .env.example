# ===== Telegram =====
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleToken

# Telegram ID администраторов (через запятую).
# Свой ID можно узнать у @userinfobot
ADMIN_IDS=123456789

# ===== ЮKassa =====
# shopId (идентификатор магазина) и секретный ключ из ЛК ЮKassa.
# Для тестов используйте тестовые ключи (раздел «Интеграция» -> тестовый магазин).
YOOKASSA_SHOP_ID=111111
YOOKASSA_SECRET_KEY=test_YourTestSecretKey

# Куда вернуть пользователя после оплаты (ссылка на бота)
RETURN_URL=https://t.me/YourBotUsername

# ===== WDTT панель =====
# Базовый URL панели (без завершающего слэша), порт 2860 по умолчанию.
# Панель может быть за самоподписанным SSL-сертификатом — тогда WDTT_VERIFY_SSL=false.
# При первом запуске эти данные станут сервером "default" (id=1) в базе.
# Остальные серверы добавляются через админ-команду /add_server.
WDTT_BASE_URL=https://1.2.3.4:2860/wdtt
WDTT_USERNAME=admin
WDTT_PASSWORD=CHANGE_ME_strong_password
WDTT_VERIFY_SSL=false

# ===== Бот =====
DB_PATH=bot.db
# Интервал (сек) проверки неоплаченных платежей
POLL_INTERVAL=10

# ===== Webhook ЮKassa (необязательно, но рекомендуется в продакшене) =====
# Включите, чтобы ЮKassa сама сообщала об оплате мгновенно.
# Порт должен быть проброшен/открыт наружу и доступен по HTTPS.
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/yookassa

# ===== Тарифы (необязательно) =====
# JSON-массив. Если не задан — используются тарифы по умолчанию из plans.py
# Поля: id, name, days, price (₽), traffic_gb (0 = безлимит), max_devices, description
# PLANS_JSON=[{"id":"month","name":"Месяц","days":30,"price":249,"traffic_gb":100,"max_devices":2,"description":"30 дней, 100 ГБ"}]

# ===== Пробный период (бесплатный, один раз на пользователя) =====
TRIAL_DAYS=3
TRIAL_TRAFFIC_GB=5
TRIAL_MAX_DEVICES=1

# ===== Реферальная программа =====
# Начисление пригласившему после первой оплаты приглашённого друга
REFERRAL_REWARD_DAYS=3
REFERRAL_REWARD_TRAFFIC_GB=0
REFERRAL_REWARD_MAX_DEVICES=1
